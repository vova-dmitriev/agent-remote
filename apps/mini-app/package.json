{
  "name": "@claude-remote/mini-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run check && vite build --config vite.config.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fsd": "steiger src",
    "lint:structure": "node ../../scripts/check-frontend-structure.mjs",
    "format:check": "prettier --check .",
    "knip": "knip",
    "storybook": "npm run prepare:storybook && storybook dev -p 6006",
    "build-storybook": "npm run prepare:storybook && storybook build",
    "test-storybook": "npm run prepare:storybook && vitest run --config vitest.storybook.config.ts",
    "check": "npm run lint && npm run lint:fsd && npm run lint:structure && npm run lint:react && npm run format:check && npm run knip",
    "lint:react": "react-doctor . --scope full --blocking warning --no-telemetry --no-supply-chain --yes",
    "prepare:storybook": "node scripts/prepare-storybook.mjs",
    "lint:fix": "eslint . --fix --max-warnings=0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.1.1",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.7",
    "lucide-react": "0.454.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.20",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.3.1",
    "zustand": "5.0.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "17.4.0",
    "knip": "6.38.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "react-doctor": "0.9.18",
    "steiger": "0.7.0",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
