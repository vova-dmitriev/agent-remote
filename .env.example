# Relay only. Never copy BOT_TOKEN to the companion.
BOT_TOKEN=
DATABASE_URL=postgres://claude_remote:CHANGE_ME@127.0.0.1:5432/claude_remote
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
# Use a URL-safe random hexadecimal password for production Compose.
REDIS_PASSWORD=
PUBLIC_ORIGIN=https://your-domain.example
HOST=127.0.0.1
PORT=3000
# Enable individually after the corresponding local compatibility checks.
REMOTE_INPUT_ENABLED=0
REMOTE_PERMISSIONS_ENABLED=0
# Development only; restricted to loopback origins.
ALLOW_INSECURE_LOCAL=0
POSTGRES_PASSWORD=
DOMAIN=
# Optional permanent domain for `npm run personal`: configure all three or none.
# Cloudflare must already manage this DNS zone and route this hostname to the tunnel.
# PERSONAL_PUBLIC_ORIGIN=https://agent.your-domain.com
# PERSONAL_TUNNEL_ID=00000000-0000-4000-8000-000000000000
# PERSONAL_TUNNEL_CREDENTIALS_FILE=/absolute/private/path/tunnel-credentials.json
# Shared Linux VM only (compose.vm.yml): a long random secret shared by the relay and the agents supervisor.
REMOTE_OPERATOR_TOKEN=
